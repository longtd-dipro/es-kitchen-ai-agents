NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=https://api.example.jp
# NEXT_PUBLIC_FIXED_TODAY=2026/10/05
# キックオフ面談の予約URL（申込の完了画面・受付メール M1）。リンクが変わったらここを直す
NEXT_PUBLIC_KICKOFF_URL=https://booking.receptionist.jp/kickoff-mtg-schedule/60min
# 規約の URL（申込の同意欄のリンク）。空ならリンクにしない。キャンペーン規約は客先から
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_CAMPAIGN_TERMS_URL=
# 法人Web のご利用マニュアル（動画＋資料）のリンク（新しいご担当者へのメール M13）。客先から受け取ったら入れる
NEXT_PUBLIC_CORP_MANUAL_URL=

# 日次バッチ（本番はスケジューラで 0:00＝midnight・9:00＝morning に POST /api/batch/run を呼ぶ。受付簿 No.51）
# BATCH_SCHEDULER=1 のとき、API の最初のアクセスでの追いかけ実行をしない（デモのビルドは今のまま）
BATCH_SCHEDULER=
# スケジューラが送るヘッダー x-batch-token の値（空なら /api/batch/run は使えない）
BATCH_TOKEN=
