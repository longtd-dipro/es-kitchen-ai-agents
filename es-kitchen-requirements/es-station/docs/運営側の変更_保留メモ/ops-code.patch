new file mode 100644
index 0000000..f275908
--- /dev/null
+++ b/lib/ops/core/versioned.ts
@@ -0,0 +1,68 @@
+import type { DocRepo } from './area';
+import { nowStamp } from '@/lib/supplier/dates';
+import { nextVersion } from './concurrency';
+
+/*
+ * 法人・拠点・子契約の「版」（同時更新の検知 E31）を、書き込みの口で一元的に進める。
+ * 画面の「保存」（contracts.save）だけでなく、申請の承認・却下／CSV取込／価格世代の一括切替／休止・復元／アカウントの停止・再開 など
+ * どの経路でこれらのデータを書いても、その法人・拠点・子契約の版が進む。開いたままの古い画面で保存すると E31（409）になる。
+ * 中身が変わらない書き込み（同じ値の put）では進めない。版は contracts.extra の ver に持つ（lib/ops/contracts/fromDomain.ts の verOf と同じ）。
+ * sqliteDocRepo と memoryRepo の出口に被せる（どの経路もここを通る）。
+ */
+export const EXTRA = 'contracts.extra';
+type Entity = 'corp' | 'branch' | 'child';
+type Extra = { id: string; form: Record<string, unknown>; ver?: string; /** 更新日時 YYYY/MM/DD HH:mm（一覧の初期の並び。台帳 一覧の初期の並び＝更新日時の降順）。版を進めるたびに更新。ない間は登録日時（子契約はサイクル月の初日）を使う */ updatedAt?: string };
+type Ref = [Entity, string];
+
+/** 版を1つ進める（進めた版を返す） */
+export function bumpEntityVer(r: DocRepo, e: Entity, id: string): string {
+  const cur = r.get<Extra>(EXTRA, `${e}:${id}`);
+  const ver = nextVersion(cur?.ver);
+  r.put<Extra>(EXTRA, `${e}:${id}`, { id: `${e}:${id}`, form: cur?.form ?? {}, ver, updatedAt: nowStamp() });
+  return ver;
+}
+
+/** 書いたデータが、どの法人・拠点・子契約の画面に影響するか */
+function affected(r: DocRepo, kind: string, id: string, data: unknown): Ref[] {
+  const d = (data ?? {}) as Record<string, unknown>;
+  const s = (v: unknown) => (typeof v === 'string' && v ? v : '');
+  switch (kind) {
+    case 'dm.org.corps': return [['corp', id]];
+    case 'dm.org.branches': return [['branch', id]];
+    case 'dm.org.childContracts': return [['child', id]];
+    case 'dm.org.contracts':
+    case 'dm.org.loans': return s(d.branchId) ? [['branch', s(d.branchId)]] : [];
+    case 'dm.org.pauses': {
+      const ct = r.get<{ branchId?: string }>('dm.org.contracts', s(d.contractId));
+      return ct?.branchId ? [['branch', ct.branchId]] : [];
+    }
+    case 'dm.org.contacts': {
+      const o = d.owner as { type?: string; id?: string } | undefined;
+      return o?.id && (o.type === 'corp' || o.type === 'branch') ? [[o.type, o.id]] : [];
+    }
+    case 'dm.account.accounts': return d.site === 'corp' ? [['corp', id]] : [];
+    default: return [];
+  }
+}
+const TRACKED = new Set(['dm.org.corps', 'dm.org.branches', 'dm.org.childContracts', 'dm.org.contracts', 'dm.org.loans', 'dm.org.pauses', 'dm.org.contacts', 'dm.account.accounts']);
+const uniq = (refs: Ref[]) => [...new Map(refs.map((x) => [x.join('|'), x])).values()];
+
+/** put／remove のたびに、影響する法人・拠点・子契約の版を進める DocRepo にする */
+export function versioned<R extends DocRepo>(base: R): R {
+  const bump = (refs: Ref[]) => { for (const [e, id] of uniq(refs)) bumpEntityVer(base, e, id); };
+  return {
+    ...base,
+    put<T>(kind: string, id: string, data: T) {
+      if (!TRACKED.has(kind)) { base.put<T>(kind, id, data); return; }
+      const prev = base.get<unknown>(kind, id);
+      base.put<T>(kind, id, data);
+      if (JSON.stringify(prev) !== JSON.stringify(data)) bump(affected(base, kind, id, data));
+    },
+    remove(kind: string, id: string) {
+      if (!TRACKED.has(kind)) { base.remove(kind, id); return; }
+      const prev = base.get<unknown>(kind, id);
+      base.remove(kind, id);
+      if (prev !== undefined) bump(affected(base, kind, id, prev));
+    },
+  };
+}
